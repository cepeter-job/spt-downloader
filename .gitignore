# Taxpayer data and browser sessions must never be versioned.
output/
outputs/
data/
checkpoints/
returns/
browser-profile/
browser-profile-*/
*-profile/
profiles/
credentials/
Cookies
Local State
*.xlsx
*.xls
*.xlsm
*.csv
*.pdf
*.json
# Konfigurasi ruleset repositori disimpan sebagai sumber yang dapat ditinjau.
!.github/rulesets/main.json
!/coverage-policy.json
*.jsonl
*.zip
.env
.env.*
*.pem
*.key
*.pfx
*.p12

# Local environments, dependency binaries and generated test files.
.venv/
venv/
.tools/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.test-tmp/
.coverage
htmlcov/
*.log

# Generated desktop binaries and packaging intermediates.
dist/
build/
*.spec

# Dedicated desktop workspace must remain private even with a custom developer root.
profile/
jobs/
runtime/
cache/
tools/
app/
*.exe
