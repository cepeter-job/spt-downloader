[run]
branch = True
relative_files = True
source = .
omit =
    tests/*
    .venv/*
data_file = ${RUNNER_TEMP?}/.coverage-portable

[report]
# Subset Linux tidak mewakili Windows; coverage-policy.json gates the complete
# Windows parent union separately. Isolated worker/bootstrap processes remain
# independently tested and unmeasured here.
show_missing = True
skip_empty = True
fail_under = 0
